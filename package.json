{
  "name": "@helsenorge/typed-scss-modules",
  "version": "10.0.1",
  "description": "TypeScript type definition generator for SCSS CSS Modules",
  "type": "module",
  "main": "dist/lib/index.js",
  "types": "dist/lib/index.d.ts",
  "author": "ROX (kopiert fra Github",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/helsenorge/typed-scss-modules"
  },
  "files": [
    "dist/lib"
  ],
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "default": "./dist/lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": "./dist/lib/cli.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typed-scss-modules": "tsc -p tsconfig.build.json && node ./dist/lib/cli.js",
    "clean": "rm -rf ./dist",
    "build": "npm run clean && tsc -p tsconfig.build.json && chmod +x dist/lib/cli.js",
    "prepare": "npm run build && husky",
    "check-types": "tsc --noEmit && tsc --noEmit -p examples",
    "check-formatting": "prettier --check '**/*.{js,json,css,md,scss,tsx,ts}'",
    "check-linting": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "@types/reserved-words": "^0.1.4",
    "@types/yargs": "^17.0.35",
    "eslint": "^10.9.1",
    "eslint-plugin-promise": "^7.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "sass": "^1.104.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "sass": "^1.49.7"
  },
  "dependencies": {
    "change-case": "^5.4.4",
    "chokidar": "^5.0.0",
    "glob": "^13.0.6",
    "postcss": "^8.5.28",
    "postcss-modules": "^9.0.1",
    "reserved-words": "^0.1.2",
    "yargs": "^18.1.0"
  },
  "lint-staged": {
    "*.{js,json,css,md,scss,tsx,ts}": [
      "prettier --write"
    ]
  }
}
